# Copy to .env.local for local development. Never commit the real values —
# .gitignore already excludes .env and .env*.local.
#
# These are read only by server-side code (src/lib/contact/mailer.ts,
# src/app/contact/actions.ts). They are never sent to the browser, embedded
# in HTML/JSON-LD, or exposed through any client-visible API.

# Contact form — required for the form to send mail.
# Resend API key: https://resend.com/api-keys
RESEND_API_KEY=
# Destination mailbox for contact form submissions.
CONTACT_TO_EMAIL=
# Verified "from" address on your Resend account/domain. The visitor's own
# address is set as the reply-to, not the from, so replies still go to them.
CONTACT_FROM_EMAIL=

# Contact form — optional rate-limit tuning (defaults: 5 messages per 10
# minutes per IP, best-effort / per-instance — see src/lib/contact/rate-limit.ts).
CONTACT_RATE_LIMIT_MAX=
CONTACT_RATE_LIMIT_WINDOW_MINUTES=
